{
  "$comment": "Generated by fpl-orchestrator/scripts/link-skills.sh. Hook paths are absolute because they point into the sibling orchestration repo. Machine-local: gitignored, re-run the script after a clone.",
  "permissions": {
    "allow": [
      "Bash(pwd)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(jq:*)",
      "Bash(readlink:*)",
      "Bash(lsof:*)",
      "Bash(curl -s https://fantasy.premierleague.com/api/*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(bash scripts/doctor.sh:*)",
      "Bash(bash scripts/link-skills.sh)"
    ]
  },
  "extraKnownMarketplaces": {
    "fantasy-premier-league": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/plugins/fpl/hooks/session-brief.sh\"",
            "timeout": 10,
            "statusMessage": "Reading gameweek state\u2026"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/plugins/fpl/hooks/pre-edit-skill-router.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/plugins/fpl/hooks/pre-bash-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/plugins/fpl/hooks/post-edit-verify.sh\"",
            "timeout": 120,
            "statusMessage": "Typechecking\u2026"
          }
        ]
      }
    ]
  }
}